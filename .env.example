# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN SHOP QUẦN ÁO & BLOG SEO (AURA FASHION)
# ==============================================================================

# 1. URL của website khi deploy công khai (Vercel, Netlify hoặc Custom Domain)
NEXT_PUBLIC_SITE_URL=https://aurafashion.vn

# 2. Mã đo lường Google Analytics 4 (GA4 Measurement ID)
# Lấy tại: GA4 > Quản trị (Admin) > Luồng dữ liệu (Data Streams) > Web > Mã đo lường
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 3. Mã xác minh Google Search Console (GSC Verification Meta Tag)
# Lấy tại: Google Search Console > Thêm tài sản > Thẻ HTML (HTML tag) > Sao chép chuỗi trong content="..."
NEXT_PUBLIC_GSC_VERIFICATION=YOUR_GOOGLE_SEARCH_CONSOLE_CODE
